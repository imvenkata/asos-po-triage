# --- Provider selection -------------------------------------------------
# azure    : Azure OpenAI (default, matches the ASOS stack)
# openai   : OpenAI direct
# scripted : deterministic offline test double, no credentials, no network.
#            Used by CI and by `make eval-offline`. See WRITEUP.md for what
#            this does and does NOT prove.
TRIAGE_LLM_PROVIDER=azure

# --- Azure OpenAI -------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
# The deployment NAME from your Azure AI Foundry Deployments list,
# which is unrelated to the underlying model name.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-luna
# Optional. If unset, retrieval runs lexical-only (BM25) and says so loudly
# rather than silently degrading.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- OpenAI direct (only when TRIAGE_LLM_PROVIDER=openai) ---------------
# OPENAI_API_KEY=<key>
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval tuning ---------------------------------------------------
TRIAGE_RETRIEVAL_TOP_K=6
# Minimum cosine similarity before an answer is treated as ungrounded.
# Calibrated for text-embedding-3-small via evals/calibrate_threshold.py.
# Re-derive it if you change embedding model - the scale is model-specific.
TRIAGE_MIN_SEMANTIC_SIMILARITY=0.38
TRIAGE_MAX_AGENT_STEPS=6

# The default refuses startup without a semantic index. Explicit degraded mode
# starts but escalates all decisions; it is for demonstrations, not production.
TRIAGE_ALLOW_LEXICAL_ONLY=false
TRIAGE_REQUEST_TIMEOUT_S=60
TRIAGE_TOTAL_TIMEOUT_S=120
TRIAGE_MAX_CONTEXT_CHUNKS=28
TRIAGE_MAX_TOOL_CALLS_PER_TURN=4
